export async function handleOrderCompleted(ecomOrder) {
    return syncApprovedOrderToDashboard(ecomOrder);
}

// ─── Store products (קטלוג לדאשבורד) ───

function unitPriceFromStoreProduct(p) {
    const parsePrice = (value) => {
        if (value == null || value === '') return NaN;
        if (typeof value === 'number') return value;
        const parsed = parseFloat(String(value).replace(/,/g, ''));
        return Number.isFinite(parsed) ? parsed : NaN;
    };

    const priceData = p.priceData || {};
    const convertedPriceData = p.convertedPriceData || {};

    // עדיפות למחיר מוזל אם קיים במבנה המוצר
    const discountedCandidates = [
        priceData.discountedPrice,
        priceData.discountedPriceAmount,
        priceData?.discount?.discountedPrice,
        priceData?.discount?.discountedPriceAmount,
        convertedPriceData.discountedPrice,
        convertedPriceData.discountedPriceAmount,
        p.discountedPrice,
        p.salePrice,
    ];
    for (const candidate of discountedCandidates) {
        const n = parsePrice(candidate);
        if (Number.isFinite(n) && n >= 0) return n;
    }

    const regularCandidates = [
        priceData.price,
        convertedPriceData.price,
        p.price,
    ];
    for (const candidate of regularCandidates) {
        const n = parsePrice(candidate);
        if (Number.isFinite(n) && n >= 0) return n;
    }

    return 0;
}

export async function getStoreProducts() {
    const result = await products.queryProducts().find();
    return result.items.map(p => {
        const price = unitPriceFromStoreProduct(p);
        return {
            id: p._id,
            name: p.name,
            image: p.media?.mainMedia?.image?.url || '',
            price,
        };
    });
}

