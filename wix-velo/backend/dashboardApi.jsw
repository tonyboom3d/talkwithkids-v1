import wixData from 'wix-data';
import { fetch } from 'wix-fetch';
import { searchContactsByQuery } from 'backend/helpers/contactHelper';
import { normalizeIsraeliPhone } from 'backend/helpers/phoneUtils';
import {
    createOrderCoupon,
    searchStoreCoupons,
    validateExistingStoreCoupon,
    computeDiscountForSubtotal,
} from 'backend/helpers/couponHelper';
import { createDashboardCheckout } from 'backend/helpers/checkoutHelper';
import {
    EXPIRED_PUBLIC_ORDER_MESSAGE,
    getPublicDashboardOrder,
    isExpiredPublicOrderRecord,
    normalizeOrderStatus,
    syncApprovedOrderToDashboard,
} from 'backend/orderService.jsw';
import { products } from 'wix-stores.v2';

export { searchContactsByQuery, searchStoreCoupons };

const LOG_PREFIX = '[VELO-BE]';
const UPDATABLE_ORDER_STATUSES = new Set(['sent', 'opened', 'paid_partial', 'paid_pending_details', 'paid_completed', 'paid', 'cancelled']);

/** LeadConnector — אחרי יצירת checkout + רשומת CMS */
const DASHBOARD_CHECKOUT_WEBHOOK_URL =
    'https://services.leadconnectorhq.com/hooks/Qt9lEQiyh8wgVPJM4d6Q/webhook-trigger/387433a5-66c1-4a3c-8aec-797419749654';

const ORDER_LINK_BASE = 'https://www.talkwithkids.co.il/dashboard-orders';

function safeParseJson(value, fallback) {
    if (!value) return fallback;
    if (typeof value !== 'string') return value;
    try {
        return JSON.parse(value);
    } catch (err) {
        return fallback;
    }
}

function appendWhatsappPendingEvent(changeChain, employeeName, { isResend = false } = {}) {
    const chain = Array.isArray(changeChain) ? [...changeChain] : [];
    chain.push({
        action: 'whatsapp_pending',
        by: employeeName || 'מערכת',
        date: new Date().toISOString(),
        detail: isResend
            ? 'נשלחה בקשה לשליחה חוזרת בוואטסאפ - יש לרענן לקבל עדכון סטטוס'
            : 'נשלחה בקשה לשליחת הודעת וואטסאפ - יש לרענן לקבל עדכון סטטוס',
    });
    return chain;
}

function buildWhatsappData({
    status = '',
    messageId = '',
    error = '',
    paymentLink = '',
    dynamicLinkId = '',
    contact = {},
} = {}) {
    return {
        status,
        messageId,
        error,
        updatedAt: new Date().toISOString(),
        paymentLink,
        dynamicLinkId,
        contact: {
            id: String(contact.id || '').trim(),
            name: String(contact.name || '').trim(),
            email: String(contact.email || '').trim(),
            phone: String(contact.phone || '').trim(),
        },
    };
}

function getStatusLabel(status) {
    const labels = {
        sent: 'נשלח',
        opened: 'נפתח',
        paid_partial: 'שולמה חלקית',
        paid_pending_details: 'שולמה - לא הושלמה',
        paid_completed: 'שולמה - הושלמה',
        paid: 'שולם',
        cancelled: 'בוטל',
        error: 'שגיאה',
    };
    return labels[status] || status;
}

/** מזהה רפרנס/עובד מה־CMS — מחרוזת או אובייקט { _id } (נפוץ בוויקס) */
function unwrapCmsRef(value) {
    if (value == null || value === '') return '';
    if (typeof value === 'object' && value._id != null) return String(value._id).trim();
    return String(value).trim();
}

/**
 * שדה צבע מרשומת AuthorizedEmployees — Text / Color ב-CMS;
 * בוויקס Color לעיתים נשמר כמחרוזת #hex או כאובייקט { hex } / RGB וכו'.
 */
function extractColorFromValue(v) {
    if (v == null) return '';
    if (typeof v === 'string') {
        const t = v.trim();
        if (/^#[0-9A-Fa-f]{3}([0-9A-Fa-f]{3})?$/i.test(t)) return t;
        if (/^rgba?\(/i.test(t)) return t;
        return '';
    }
    if (typeof v === 'object') {
        if (v.hex != null) return extractColorFromValue(v.hex);
        if (v.color != null && v !== v.color) return extractColorFromValue(v.color);
        if (typeof v.value === 'string') return extractColorFromValue(v.value);
        if (typeof v.value === 'object' && v.value != null) return extractColorFromValue(v.value);
        if (
            typeof v.red === 'number' &&
            typeof v.green === 'number' &&
            typeof v.blue === 'number'
        ) {
            const r = Math.max(0, Math.min(255, Math.round(v.red)));
            const g = Math.max(0, Math.min(255, Math.round(v.green)));
            const b = Math.max(0, Math.min(255, Math.round(v.blue)));
            return `#${[r, g, b].map((x) => x.toString(16).padStart(2, '0')).join('')}`;
        }
    }
    return '';
}

function colorFromEmployeeItem(item) {
    if (!item || typeof item !== 'object') return '';
    const keys = ['color', 'Color', 'tagColor', 'TagColor', 'colour', 'Colour'];
    for (const k of keys) {
        if (item[k] == null) continue;
        const c = extractColorFromValue(item[k]);
        if (c) return c;
    }
    const fromStringify = JSON.stringify(item).match(/#[0-9A-Fa-f]{6}\b|#[0-9A-Fa-f]{3}\b/);
    if (fromStringify) return fromStringify[0];
    return '';
}

async function getEmployeeMetaMap(employeeIds) {
    const rawIds = (employeeIds || []).map(unwrapCmsRef).filter(Boolean);
    const ids = [...new Set(rawIds)];
    if (ids.length === 0) return {};
    const result = await wixData.query('AuthorizedEmployees')
        .hasSome('_id', ids)
        .limit(Math.min(ids.length, 100))
        .find({ suppressAuth: true });
    return (result.items || []).reduce((acc, item) => {
        const id = String(item._id).trim();
        acc[id] = {
            displayName: item.displayName || '',
            color: colorFromEmployeeItem(item),
        };
        return acc;
    }, {});
}

function normalizeTimelineEvent(event, employeeMetaMap = {}) {
    const rawBy = event?.by || '';
    const byKey = unwrapCmsRef(rawBy) || String(rawBy).trim();
    const meta = employeeMetaMap[byKey] || employeeMetaMap[String(rawBy).trim()];
    const resolvedBy = meta?.displayName || rawBy || 'מערכת';
    const actorType = (() => {
        if (resolvedBy === 'מערכת') return 'system';
        if (String(resolvedBy).includes('לקוח')) return 'customer';
        return 'employee';
    })();

    return {
        ...event,
        by: resolvedBy,
        actorType,
    };
}

function normalizeOrderRecord(item, employeeMetaMap = {}) {
    const changeChain = safeParseJson(item.changeChain, []).map((event) => normalizeTimelineEvent(event, employeeMetaMap));
    const productsList = safeParseJson(item.products, []);
    const couponDetails = safeParseJson(item.couponDetails, null);
    const refKey = unwrapCmsRef(item.createdByRef);
    const creatorMeta = employeeMetaMap[refKey] || employeeMetaMap[String(item.createdByRef || '').trim()];
    return {
        ...item,
        changeChain,
        products: productsList,
        couponDetails,
        deliveryNumber: item.deliveryNumber || '',
        createdByName: item.createdByName || creatorMeta?.displayName || '',
        creatorTagColor: creatorMeta?.color || '',
    };
}

// ─── Employee Permissions ───

export async function getEmployeePermissions(memberId) {
    const result = await wixData.query('AuthorizedEmployees')
        .eq('connectedMembers', memberId)
        .find({ suppressAuth: true });

    if (result.items.length === 0) {
        return null;
    }

    const emp = result.items[0];
    return {
        _id: emp._id,
        displayName: emp.displayName,
        canViewOtherRecords: !!emp.canViewOtherRecords,
        commissionRate: emp.commissionRate || 0,
        color: colorFromEmployeeItem(emp),
    };
}

// ─── Order Records (CMS) ───

export async function getOrderRecords(employeeId, canViewOthers) {
    let query = wixData.query('DashboardOrders');
    if (!canViewOthers) {
        query = query.eq('createdByRef', employeeId);
    }
    const results = await query
        .descending('_createdDate')
        .limit(100)
        .find({ suppressAuth: true });

    const items = (results.items || []).filter((item) => !item.deletedAt);
    const employeeIds = items.flatMap((item) => {
        const chain = safeParseJson(item.changeChain, []);
        return [item.createdByRef, ...chain.map((event) => event?.by)]
            .filter(Boolean)
            .map(unwrapCmsRef);
    });
    const employeeMetaMap = await getEmployeeMetaMap(employeeIds);
    return items.map((item) => normalizeOrderRecord(item, employeeMetaMap));
}

export async function getOrderDetails(recordId) {
    const item = await wixData.get('DashboardOrders', recordId, { suppressAuth: true });
    const chain = safeParseJson(item.changeChain, []);
    const employeeMetaMap = await getEmployeeMetaMap(
        [item.createdByRef, ...chain.map((event) => event?.by)]
            .filter(Boolean)
            .map(unwrapCmsRef)
    );
    return normalizeOrderRecord(item, employeeMetaMap);
}

function formatPublicCouponDetails(couponDetails) {
    if (!couponDetails) return '';
    if (couponDetails.source === 'auto_paid') {
        return '100% הנחה - ההזמנה כבר שולמה';
    }
    if (couponDetails.source === 'partial_paid') {
        return `שולם מראש ₪${Number(couponDetails.paidAmount || couponDetails.value || 0).toLocaleString('he-IL')}`;
    }
    if (couponDetails.source === 'existing') {
        return couponDetails.code ? `קוד קופון: ${couponDetails.code}` : 'קופון הנחה קיים';
    }
    if (couponDetails.source === 'create') {
        const value = Number(couponDetails.value || 0);
        if (couponDetails.type === 'percent') {
            return couponDetails.code
                ? `${value}% הנחה (${couponDetails.code})`
                : `${value}% הנחה`;
        }
        return couponDetails.code
            ? `₪${value.toLocaleString('he-IL')} הנחה (${couponDetails.code})`
            : `₪${value.toLocaleString('he-IL')} הנחה`;
    }
    return '';
}

function getPublicStatusConfig(status, paymentLink) {
    switch (normalizeOrderStatus(status)) {
    case 'paid_partial':
        return {
            text: 'ההזמנה שולמה חלקית. נותר להשלים את היתרה דרך הקישור.',
            tone: 'info',
            ctaLabel: paymentLink ? 'השלימי את יתרת התשלום >>' : '',
            canContinue: !!paymentLink,
        };
    case 'paid_pending_details':
        return {
            text: 'הזמנה שולמה ממתין להשלמת פרטי לקוח',
            tone: 'info',
            ctaLabel: paymentLink ? 'השלימי את הפרטים שלך >>' : '',
            canContinue: !!paymentLink,
        };
    case 'paid_completed':
        return {
            text: 'ההזמנה שולמה בהצלחה.',
            tone: 'success',
            ctaLabel: '',
            canContinue: false,
        };
    case 'cancelled':
    case 'error':
        return {
            text: 'ההזמנה בוטלה יש לפנות לשירות לקוחות',
            tone: 'danger',
            ctaLabel: '',
            canContinue: false,
        };
    case 'opened':
    case 'sent':
    default:
        return {
            text: 'ממתין לתשלום',
            tone: 'waiting',
            ctaLabel: paymentLink ? 'המשיכי לתשלום >>' : '',
            canContinue: !!paymentLink,
        };
    }
}

function resolvePublicPaymentLink(record) {
    return record?.checkoutLink || '';
}

export async function getPublicOrderForIframe(dynamicLinkId) {
    const normalizedId = String(dynamicLinkId || '').trim();
    if (!normalizedId) {
        return {
            ok: false,
            code: 'MISSING_ORDER_ID',
            message: 'אופס... לא מצאתי את ההזמנה שלך',
        };
    }

    try {
        const record = await getPublicDashboardOrder(normalizedId);

        if (!record) {
            return {
                ok: false,
                code: 'ORDER_NOT_FOUND',
                message: 'אופס... לא מצאתי את ההזמנה שלך',
            };
        }

        if (isExpiredPublicOrderRecord(record)) {
            return {
                ok: false,
                code: 'ORDER_LINK_EXPIRED',
                message: EXPIRED_PUBLIC_ORDER_MESSAGE,
            };
        }

        const couponDetails = safeParseJson(record.couponDetails, null);
        const paymentLink = resolvePublicPaymentLink(record);
        const statusConfig = getPublicStatusConfig(record.status, paymentLink);

        return {
            ok: true,
            order: {
                customerName: record.customerName || '',
                createdDate: record._createdDate || null,
                customerPhone: record.customerPhone || '',
                totalPrice: Number(record.totalPrice || 0),
                couponDetailsText: formatPublicCouponDetails(couponDetails),
                hasCoupon: !!couponDetails,
                status: normalizeOrderStatus(record.status) || 'sent',
                statusText: statusConfig.text,
                statusTone: statusConfig.tone,
                paymentLink,
                canContinue: statusConfig.canContinue,
                ctaLabel: statusConfig.ctaLabel,
            },
        };
    } catch (err) {
        console.error(`${LOG_PREFIX} getPublicOrderForIframe failed:`, err);
        return {
            ok: false,
            code: 'ORDER_LOOKUP_FAILED',
            message: 'אופס... לא מצאתי את ההזמנה שלך',
        };
    }
}

// ─── Create Order ───

function buildDashboardOrderUrl(dynamicLinkId) {
    const id = String(dynamicLinkId || '').trim();
    if (!id) return ORDER_LINK_BASE;
    return `${ORDER_LINK_BASE}?id=${encodeURIComponent(id)}`;
}

/** שומר ב־couponDetails את סכום הסל לפני הנחה ואחרי הנחה (לתצוגה בדאשבורד) */
function enrichCouponDetailsWithTotals(couponDetailsObj, subtotal, existingStoreCouponMapped) {
    if (!couponDetailsObj) return;
    const s = Math.max(0, Number(subtotal) || 0);
    let discountedTotal = s;

    if (couponDetailsObj.source === 'auto_paid') {
        discountedTotal = 0;
    } else if (couponDetailsObj.source === 'partial_paid') {
        const paidAmount = Math.min(s, Math.max(0, Number(couponDetailsObj.paidAmount ?? couponDetailsObj.value) || 0));
        discountedTotal = Math.max(0, s - paidAmount);
        couponDetailsObj.paidAmount = paidAmount;
        couponDetailsObj.value = paidAmount;
        couponDetailsObj.remainingAmount = discountedTotal;
    } else if (couponDetailsObj.source === 'create') {
        if (couponDetailsObj.type === 'percent') {
            const pct = Math.min(100, Math.max(0, Number(couponDetailsObj.value) || 0));
            discountedTotal = s * (1 - pct / 100);
        } else {
            const off = Math.min(s, Math.max(0, Number(couponDetailsObj.value) || 0));
            discountedTotal = s - off;
        }
    } else if (couponDetailsObj.source === 'existing' && existingStoreCouponMapped) {
        discountedTotal = computeDiscountForSubtotal(s, existingStoreCouponMapped).discountedTotal;
    }

    couponDetailsObj.subtotal = s;
    couponDetailsObj.discountedTotal = Math.max(0, discountedTotal);
}

function normalizeCreatedCouponInput(couponInput, subtotal) {
    if (!couponInput) return null;

    const s = Math.max(0, Number(subtotal) || 0);

    if (couponInput.targetPayAmount != null && couponInput.targetPayAmount !== '') {
        const targetPayAmount = Number(couponInput.targetPayAmount);
        if (!Number.isFinite(targetPayAmount)) {
            throw new Error('סכום לתשלום לא תקין');
        }
        if (targetPayAmount < 0 || targetPayAmount > s) {
            throw new Error('סכום לתשלום חייב להיות בין 0 לסכום ההזמנה');
        }

        const discountAmount = Math.max(0, s - targetPayAmount);
        if (discountAmount === 0) {
            return {
                shouldCreateCoupon: false,
                couponDetailsObj: null,
            };
        }

        return {
            shouldCreateCoupon: true,
            type: 'fixed',
            value: discountAmount,
            couponDetailsObj: {
                source: 'create',
                type: 'fixed',
                value: discountAmount,
                targetPayAmount,
            },
        };
    }

    const type = couponInput.type === 'percent' ? 'percent' : 'fixed';
    const value = Number(couponInput.value);
    if (!Number.isFinite(value)) {
        throw new Error('ערך הקופון לא תקין');
    }

    if (type === 'percent') {
        if (value < 0 || value > 100) {
            throw new Error('ערך הקופון לא תקין');
        }
    } else if (value < 0 || value > s) {
        throw new Error('ערך הקופון לא תקין');
    }

    return {
        shouldCreateCoupon: value > 0,
        type,
        value,
        couponDetailsObj: value > 0
            ? {
                source: 'create',
                type,
                value,
            }
            : null,
    };
}

async function sendDashboardCheckoutWebhook({ customerName, customerPhone, dynamicLinkId }) {
    const paymentUrl = buildDashboardOrderUrl(dynamicLinkId);
    const payload = {
        customerName: customerName || '',
        customerPhone: customerPhone || '',
        paymentUrl,
        paymentLink: paymentUrl,
        payment_url: paymentUrl,
        dynamic_payment_link: paymentUrl,
        dynamicLinkId: String(dynamicLinkId || '').trim(),
    };
    try {
        const res = await fetch(DASHBOARD_CHECKOUT_WEBHOOK_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
        });
        const text = await res.text();
        console.log(`${LOG_PREFIX} Checkout webhook sent status=${res.status} paymentUrl=${paymentUrl} body=${text.slice(0, 200)}`);
    } catch (err) {
        console.error(`${LOG_PREFIX} Checkout webhook failed:`, err.message || err);
    }
}

async function deliverOrderToWhatsapp(record, employeeName, { isResend = false } = {}) {
    if (record.status === 'cancelled' || record.status === 'error') {
        throw new Error('לא ניתן לשלוח קישור להזמנה שבוטלה או נמצאת בסטטוס שגיאה');
    }
    if (!record.checkoutId) {
        throw new Error('לא נמצא קישור תשלום לשליחה');
    }

    const dyn =
        String(record.dynamicLinkId || '').trim() ||
        (record._id ? String(record._id).substring(0, 16) : '');
    await sendDashboardCheckoutWebhook({
        customerName: record.customerName || '',
        customerPhone: record.customerPhone || '',
        dynamicLinkId: dyn,
    });

    const paymentUrl = buildDashboardOrderUrl(dyn);
    const chain = appendWhatsappPendingEvent(
        safeParseJson(record.changeChain, []),
        employeeName,
        { isResend }
    );

    await wixData.update('DashboardOrders', {
        ...record,
        changeChain: JSON.stringify(chain),
        // Avoid false "opened" transitions from WhatsApp link previews.
        // Mark as "requested" so public link open within a few seconds won't flip sent->opened.
        whatsappData: JSON.stringify(buildWhatsappData({
            status: 'requested',
            paymentLink: paymentUrl,
            dynamicLinkId: dyn,
        })),
    }, { suppressAuth: true });
}

export async function createOrderRecord(orderData, employeeId, employeeName = '') {
    console.log(`${LOG_PREFIX} Creating order for employee: ${employeeId}`);

    let couponResult = null;
    let couponDetailsObj = null;
    let existingStoreCouponMapped = null;
    const isMarkedPaid = orderData.paymentStatus === 'paid';
    const isMarkedPartial = orderData.paymentStatus === 'paid_partial';
    const orderSubtotal = Math.max(0, Number(orderData.totalPrice) || 0);
    const requestedPartialPaidAmount = Number(orderData.partialPayment?.amountPaid);
    const hasPartialPaymentInput = orderData.partialPayment?.amountPaid != null && orderData.partialPayment?.amountPaid !== '';
    const requestedActualPaidAmount = Number(orderData.actualPaidAmount);
    const hasActualPaidAmountInput = orderData.actualPaidAmount != null && orderData.actualPaidAmount !== '';
    if (isMarkedPartial) {
        if (!Number.isFinite(requestedPartialPaidAmount) || requestedPartialPaidAmount <= 0 || requestedPartialPaidAmount >= orderSubtotal) {
            throw new Error('הסכום ששולם חלקית חייב להיות גדול מ-0 וקטן מסכום ההזמנה');
        }
    }
    if (isMarkedPaid && hasActualPaidAmountInput) {
        if (!Number.isFinite(requestedActualPaidAmount) || requestedActualPaidAmount <= 0) {
            throw new Error('הסכום ששולם בפועל חייב להיות גדול מ-0');
        }
    }
    const isPartiallyPaid = (
        isMarkedPartial
        && hasPartialPaymentInput
        && Number.isFinite(requestedPartialPaidAmount)
        && requestedPartialPaidAmount > 0
        && requestedPartialPaidAmount < orderSubtotal
    );
    const initialStatus = isPartiallyPaid ? 'paid_partial' : isMarkedPaid ? 'paid_pending_details' : 'sent';

    if (isPartiallyPaid) {
        const paidAmount = Math.min(orderSubtotal, Math.max(0, requestedPartialPaidAmount));
        couponResult = await createOrderCoupon('fixed', paidAmount);
        couponDetailsObj = {
            source: 'partial_paid',
            type: 'fixed',
            value: paidAmount,
            paidAmount,
            remainingAmount: Math.max(0, orderSubtotal - paidAmount),
            code: couponResult.code,
        };
        console.log(`${LOG_PREFIX} Auto-created partial payment coupon: paid=${paidAmount}, remaining=${Math.max(0, orderSubtotal - paidAmount)}, code=${couponResult.code}`);
    } else if (isMarkedPaid) {
        couponResult = await createOrderCoupon('percent', 100);
        couponDetailsObj = {
            source: 'auto_paid',
            type: 'percent',
            value: 100,
            code: couponResult.code,
            actualPaidAmount: hasActualPaidAmountInput ? requestedActualPaidAmount : undefined,
        };
        console.log(`${LOG_PREFIX} Auto-created 100% coupon for paid order: ${couponResult.code}`);
    } else if (orderData.existingCoupon?.id && orderData.existingCoupon?.code) {
        const validated = await validateExistingStoreCoupon(
            orderData.existingCoupon.id,
            orderData.existingCoupon.code
        );
        if (!validated) {
            throw new Error('הקופון לא נמצא, אינו פעיל לחנות, או שאינו תואם');
        }
        existingStoreCouponMapped = validated;
        couponResult = { couponId: validated.id, code: validated.code };
        couponDetailsObj = {
            source: 'existing',
            couponId: validated.id,
            code: validated.code,
        };
        console.log(`${LOG_PREFIX} Using existing store coupon: ${validated.code}`);
    } else if (orderData.coupon) {
        const normalizedCreatedCoupon = normalizeCreatedCouponInput(orderData.coupon, orderSubtotal);
        if (normalizedCreatedCoupon?.shouldCreateCoupon) {
            couponResult = await createOrderCoupon(
                normalizedCreatedCoupon.type,
                normalizedCreatedCoupon.value
            );
            couponDetailsObj = {
                ...normalizedCreatedCoupon.couponDetailsObj,
                code: couponResult.code,
            };
            console.log(`${LOG_PREFIX} Coupon created: ${couponResult.code}`);
        } else {
            console.log(`${LOG_PREFIX} Coupon skipped: no discount needed`);
        }
    }

    if (couponDetailsObj) {
        enrichCouponDetailsWithTotals(couponDetailsObj, orderSubtotal, existingStoreCouponMapped);
    }
    if (isPartiallyPaid && !couponResult?.code) {
        throw new Error('לא נוצר קופון להשלמת יתרת תשלום עבור הזמנה ששולמה חלקית');
    }

    const normalizedPhone = await normalizeIsraeliPhone(orderData.customer.phone || "");
    let contactId = orderData.customer.contactId;
    if (!contactId && normalizedPhone) {
        const existing = await searchContactsByQuery(normalizedPhone);
        if (existing.length > 0) {
            contactId = existing[0].id;
        }
    }

    const record = {
        orderNumber: '',
        deliveryNumber: '',
        status: initialStatus,
        createdByRef: employeeId,
        createdByName: employeeName || '',
        paymentMethod: orderData.paymentTag || '',
        partialPaidAmount: isPartiallyPaid
            ? requestedPartialPaidAmount
            : (isMarkedPaid && hasActualPaidAmountInput ? requestedActualPaidAmount : 0),
        products: JSON.stringify(orderData.products),
        totalPrice: orderData.totalPrice,
        couponId: couponResult?.couponId || '',
        couponDetails: couponDetailsObj ? JSON.stringify(couponDetailsObj) : '',
        notes: orderData.notes || '',
        orderChangeNotes: orderData.orderChanges || '',
        changeChain: JSON.stringify([
            {
                action: 'created',
                by: employeeName || employeeId,
                date: new Date().toISOString(),
                detail: isPartiallyPaid
                    ? `ההזמנה סומנה כששולמה חלקית. שולם מראש ₪${requestedPartialPaidAmount.toLocaleString('he-IL')}`
                    : isMarkedPaid
                    ? (
                        hasActualPaidAmountInput
                            ? `הזמנה סומנה כשולמה וממתינה להשלמת פרטים דרך הקישור. שולם בפועל ₪${requestedActualPaidAmount.toLocaleString('he-IL')}`
                            : 'הזמנה סומנה כשולמה וממתינה להשלמת פרטים דרך הקישור'
                    )
                    : 'הזמנה נוצרה',
            }
        ]),
        payerContactId: contactId || '',
        customerName: orderData.customer.firstName + (orderData.customer.lastName ? ' ' + orderData.customer.lastName : ''),
        customerPhone: normalizedPhone || '',
        customerEmail: orderData.customer.email || '',
        errors: '',
        completedOrderData: '',
    };

    const inserted = await wixData.insert('DashboardOrders', record, { suppressAuth: true });
    console.log(`${LOG_PREFIX} Order record inserted: ${inserted._id}`);

    const dynamicId = inserted._id.substring(0, 16);
    const dynamicOrderUrl = buildDashboardOrderUrl(dynamicId);
    await wixData.update('DashboardOrders', {
        ...inserted,
        dynamicLinkId: dynamicId,
        dynamicOrderUrl,
    }, { suppressAuth: true });

    let checkoutResult = null;
    try {
        checkoutResult = await createDashboardCheckout({
            products: orderData.products,
            contactId,
            orderChangeNotes: orderData.orderChanges || '',
            couponCode: couponResult?.code || null,
            lockCouponCode: isMarkedPaid,
        });

        const currentRecord = await wixData.get('DashboardOrders', inserted._id, { suppressAuth: true });
        await wixData.update('DashboardOrders', {
            ...currentRecord,
            checkoutId: checkoutResult.checkoutId,
            checkoutLink: checkoutResult.checkoutUrl,
            dynamicLinkId: dynamicId,
            dynamicOrderUrl,
        }, { suppressAuth: true });

        console.log(`${LOG_PREFIX} Checkout created: ${checkoutResult.checkoutId}`);

    } catch (err) {
        console.error(`${LOG_PREFIX} Checkout creation failed:`, err);
        const currentRecord = await wixData.get('DashboardOrders', inserted._id, { suppressAuth: true });
        const chain = JSON.parse(currentRecord.changeChain || '[]');
        chain.push({
            action: 'error',
            by: 'מערכת',
            date: new Date().toISOString(),
            detail: `אירעה תקלה ביצירת קישור התשלום: ${err.message || 'שגיאה לא ידועה'}`,
        });
        await wixData.update('DashboardOrders', {
            ...currentRecord,
            dynamicLinkId: dynamicId,
            dynamicOrderUrl,
            errors: JSON.stringify({ checkout: err.message }),
            status: 'error',
            changeChain: JSON.stringify(chain),
        }, { suppressAuth: true });
    }

    return {
        recordId: inserted._id,
        orderNumber: '',
        checkoutLink: checkoutResult?.checkoutUrl || '',
        orderUrl: buildDashboardOrderUrl(dynamicId),
        dynamicLinkId: dynamicId,
    };
}

// ─── Add Note ───

export async function addOrderNote(recordId, noteText, employeeName) {
    const record = await wixData.get('DashboardOrders', recordId, { suppressAuth: true });

    const chain = JSON.parse(record.changeChain || '[]');
    chain.push({
        action: 'note',
        by: employeeName,
        date: new Date().toISOString(),
        detail: noteText,
    });

    await wixData.update('DashboardOrders', {
        ...record,
        changeChain: JSON.stringify(chain),
    }, { suppressAuth: true });
}

export async function sendOrderWhatsapp(recordId, employeeName) {
    const record = await wixData.get('DashboardOrders', recordId, { suppressAuth: true });
    const chain = JSON.parse(record.changeChain || '[]');
    const whatsappStatus = String(safeParseJson(record.whatsappData, null)?.status || '').trim().toLowerCase();
    const wasAlreadySent = (
        whatsappStatus === 'requested'
        || whatsappStatus === 'success'
        || whatsappStatus === 'failed'
        || chain.some((event) => {
            const action = event.action || event.type;
            return action === 'whatsapp_pending'
                || action === 'whatsapp_sent_success'
                || action === 'whatsapp_sent_failed';
        })
    );
    if (wasAlreadySent) {
        throw new Error('הקישור כבר נשלח בעבר. ניתן להשתמש בשליחה חוזרת לוואטסאפ.');
    }

    await deliverOrderToWhatsapp(record, employeeName, { isResend: false });
}

// ─── Cancel Link ───

export async function cancelOrderLink(recordId, employeeName) {
    const record = await wixData.get('DashboardOrders', recordId, { suppressAuth: true });
    if (record.status === 'error') {
        throw new Error('לא ניתן לבצע פעולות על הזמנה שבסטטוס שגיאה');
    }

    const chain = JSON.parse(record.changeChain || '[]');
    chain.push({
        action: 'cancelled',
        by: employeeName,
        date: new Date().toISOString(),
        detail: 'קישור תשלום בוטל',
    });

    await wixData.update('DashboardOrders', {
        ...record,
        status: 'cancelled',
        changeChain: JSON.stringify(chain),
    }, { suppressAuth: true });
}

export async function resendOrderWhatsapp(recordId, employeeName) {
    const record = await wixData.get('DashboardOrders', recordId, { suppressAuth: true });
    await deliverOrderToWhatsapp(record, employeeName, { isResend: true });
}

export async function updateOrderStatus(recordId, nextStatus, employeeName, options = {}) {
    if (!UPDATABLE_ORDER_STATUSES.has(nextStatus)) {
        throw new Error('סטטוס לא נתמך');
    }

    const record = await wixData.get('DashboardOrders', recordId, { suppressAuth: true });
    if (record.status === 'error') {
        throw new Error('לא ניתן לעדכן סטטוס של הזמנה שבסטטוס שגיאה');
    }
    const chain = JSON.parse(record.changeChain || '[]');
    const updatePayload = {
        ...record,
        status: nextStatus,
    };

    if (nextStatus === 'paid_partial') {
        const subtotal = Math.max(0, Number(record.totalPrice) || 0);
        const requestedPaidAmount = Number(options.partialPayment?.amountPaid);
        const paymentTag = String(options.paymentTag || '').trim();
        if (!Number.isFinite(requestedPaidAmount) || requestedPaidAmount <= 0 || requestedPaidAmount >= subtotal) {
            throw new Error('הסכום ששולם חלקית חייב להיות גדול מ-0 וקטן מסכום ההזמנה');
        }
        if (!paymentTag) {
            throw new Error('יש לבחור אופן תשלום עבור הזמנה ששולמה חלקית');
        }

        const paidAmount = Math.min(subtotal, Math.max(0, requestedPaidAmount));
        const couponResult = await createOrderCoupon('fixed', paidAmount);
        const couponDetailsObj = {
            source: 'partial_paid',
            type: 'fixed',
            value: paidAmount,
            paidAmount,
            remainingAmount: Math.max(0, subtotal - paidAmount),
            code: couponResult.code,
        };
        enrichCouponDetailsWithTotals(couponDetailsObj, subtotal);

        const checkoutResult = await createDashboardCheckout({
            products: safeParseJson(record.products, []),
            contactId: record.payerContactId || '',
            orderChangeNotes: record.orderChangeNotes || '',
            couponCode: couponResult.code,
        });

        updatePayload.paymentMethod = paymentTag;
        updatePayload.partialPaidAmount = paidAmount;
        updatePayload.couponId = couponResult?.couponId || '';
        updatePayload.couponDetails = JSON.stringify(couponDetailsObj);
        updatePayload.checkoutId = checkoutResult.checkoutId;
        updatePayload.checkoutLink = checkoutResult.checkoutUrl;

        chain.push({
            action: 'status_updated',
            by: employeeName,
            date: new Date().toISOString(),
            detail: `סטטוס ההזמנה עודכן לשולמה חלקית. שולם מראש ₪${paidAmount.toLocaleString('he-IL')} באמצעות ${paymentTag}`,
        });
    } else {
        chain.push({
            action: 'status_updated',
            by: employeeName,
            date: new Date().toISOString(),
            detail: `סטטוס ההזמנה עודכן ל-${getStatusLabel(nextStatus)}`,
        });
    }

    await wixData.update('DashboardOrders', {
        ...updatePayload,
        changeChain: JSON.stringify(chain),
    }, { suppressAuth: true });
}

export async function deleteOrderRecord(recordId, employeeName) {
    const record = await wixData.get('DashboardOrders', recordId, { suppressAuth: true });
    if (record.status === 'error') {
        throw new Error('לא ניתן לבצע פעולות על הזמנה שבסטטוס שגיאה');
    }
    const chain = JSON.parse(record.changeChain || '[]');
    chain.push({
        action: 'deleted',
        by: employeeName,
        date: new Date().toISOString(),
        detail: 'ההזמנה נמחקה מלוח הבקרה',
    });

    await wixData.update('DashboardOrders', {
        ...record,
        status: 'cancelled',
        deletedAt: new Date().toISOString(),
        changeChain: JSON.stringify(chain),
    }, { suppressAuth: true });
}

