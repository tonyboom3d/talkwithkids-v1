import wixData from 'wix-data';
import {
    EXPIRED_PUBLIC_ORDER_MESSAGE,
    getPublicDashboardOrder,
    normalizeOrderStatus,
} from 'backend/orderService.jsw';
import {
    createDashboardCheckout,
    appendCheckoutToHistory,
} from 'backend/helpers/checkoutHelper';

const LOG_PREFIX = '[VELO-PUBLIC-ORDER]';
const EXPIRED_STATUSES = ['paid', 'paid_completed'];

function statusValueToString(status) {
    if (status == null) return '';
    if (typeof status === 'string') return status.trim();
    if (typeof status === 'object') {
        const fromKnownKeys = String(
            status.key
            || status.value
            || status.label
            || status.status
            || status._id
            || ''
        ).trim();
        if (fromKnownKeys) return fromKnownKeys;
    }
    return String(status).trim();
}

function normalizePublicStatus(status) {
    const raw = statusValueToString(status);
    if (!raw) return '';
    const normalized = normalizeOrderStatus(raw);
    if (typeof normalized === 'string' && normalized.trim()) {
        return normalized.trim();
    }
    return raw;
}

function safeParseJson(value, fallback) {
    if (!value) return fallback;
    if (typeof value !== 'string') return value;
    try {
        return JSON.parse(value);
    } catch (err) {
        return fallback;
    }
}

function formatPublicCouponDetails(couponDetails) {
    if (!couponDetails) return '';
    if (couponDetails.source === 'auto_paid') {
        return '100% הנחה - ההזמנה כבר שולמה';
    }
    if (couponDetails.source === 'partial_paid') {
        return `שולם מראש ₪${Number(couponDetails.paidAmount || couponDetails.value || 0).toLocaleString('he-IL')}`;
    }
    if (couponDetails.source === 'existing') {
        return couponDetails.code ? `קוד קופון: ${couponDetails.code}` : 'קופון הנחה קיים';
    }
    if (couponDetails.source === 'create') {
        const value = Number(couponDetails.value || 0);
        if (couponDetails.type === 'percent') {
            return couponDetails.code ? `${value}% הנחה (${couponDetails.code})` : `${value}% הנחה`;
        }
        return couponDetails.code
            ? `₪${value.toLocaleString('he-IL')} הנחה (${couponDetails.code})`
            : `₪${value.toLocaleString('he-IL')} הנחה`;
    }
    return '';
}

function getPublicStatusConfig(status) {
    const normalizedStatus = normalizePublicStatus(status);
    switch (normalizedStatus) {
    case 'paid_partial':
        return {
            text: 'ההזמנה שולמה חלקית. נותר להשלים את יתרת התשלום.',
            tone: 'info',
            ctaLabel: 'המשיכי לתשלום יתרה >>',
            canContinue: true,
        };
    case 'paid_pending_details':
        return {
            text: 'הזמנה שולמה ממתין להשלמת פרטי לקוח',
            tone: 'info',
            ctaLabel: 'השלימי את הפרטים שלך >>',
            canContinue: true,
        };
    case 'paid_completed':
        return {
            text: 'ההזמנה שולמה בהצלחה.',
            tone: 'success',
            ctaLabel: '',
            canContinue: false,
        };
    case 'cancelled':
    case 'error':
        return {
            text: 'ההזמנה בוטלה יש לפנות לשירות לקוחות',
            tone: 'danger',
            ctaLabel: '',
            canContinue: false,
        };
    case 'opened':
    case 'sent':
    default:
        return {
            text: 'ממתין לתשלום',
            tone: 'waiting',
            ctaLabel: 'המשיכי לתשלום >>',
            canContinue: true,
        };
    }
}

function safeParseCheckoutSessionData(value) {
    if (!value) return null;
    try {
        const parsed = typeof value === 'string' ? JSON.parse(value) : value;
        return parsed && parsed.draft ? parsed : null;
    } catch (_) {
        return null;
    }
}

const NON_PAYABLE_STATUSES = new Set(['paid', 'paid_completed', 'cancelled', 'error']);

function buildDraftFallbackFromRecord(record) {
    const couponDetails = safeParseJson(record?.couponDetails, null);
    return {
        products: safeParseJson(record?.products, []),
        orderChangeNotes: String(record?.orderChangeNotes || ''),
        couponCode: String(couponDetails?.code || '').trim() || null,
        lockCouponCode: normalizeOrderStatus(record?.status) === 'paid_pending_details',
    };
}

function computePublicPriceDisplay(record, couponDetails) {
    const subtotal = Math.max(0, Number(record.totalPrice) || 0);
    let payPrice = subtotal;
    let originalPrice = subtotal;

    if (couponDetails) {
        if (couponDetails.discountedTotal != null && Number.isFinite(Number(couponDetails.discountedTotal))) {
            payPrice = Math.max(0, Number(couponDetails.discountedTotal));
            originalPrice = couponDetails.subtotal != null
                ? Math.max(0, Number(couponDetails.subtotal))
                : subtotal;
        } else if (couponDetails.source === 'auto_paid') {
            payPrice = 0;
            originalPrice = subtotal;
        } else if (couponDetails.source === 'create') {
            if (couponDetails.type === 'percent') {
                const pct = Math.min(100, Math.max(0, Number(couponDetails.value) || 0));
                payPrice = subtotal * (1 - pct / 100);
            } else if (couponDetails.type === 'fixed') {
                const off = Math.min(subtotal, Math.max(0, Number(couponDetails.value) || 0));
                payPrice = Math.max(0, subtotal - off);
            }
            originalPrice = subtotal;
        } else if (couponDetails.source === 'partial_paid') {
            const paidAmount = Math.min(subtotal, Math.max(0, Number(couponDetails.paidAmount ?? couponDetails.value) || 0));
            payPrice = Math.max(0, subtotal - paidAmount);
            originalPrice = subtotal;
        }
    }

    const showCompare = !!couponDetails && Math.abs(originalPrice - payPrice) > 0.009;
    return {
        originalPrice,
        payPrice,
        showCompare,
    };
}

function isPaidOrderStatus(status) {
    const normalizedStatus = normalizeOrderStatus(status);
    return normalizedStatus === 'paid_completed' || normalizedStatus === 'paid';
}

function normalizePublicProducts(productsValue) {
    const rawProducts = safeParseJson(productsValue, []);
    if (!Array.isArray(rawProducts)) return [];
    return rawProducts.map((product, index) => {
        const quantity = Math.max(1, Number(product?.quantity) || 1);
        const unitPrice = Math.max(0, Number(product?.price) || 0);
        return {
            id: product?.id || `product-${index}`,
            name: product?.name || 'מוצר',
            image: product?.image || '',
            quantity,
            unitPrice,
            lineTotal: unitPrice * quantity,
        };
    });
}

export async function getPublicOrderForIframe(dynamicLinkId) {
    const normalizedId = String(dynamicLinkId || '').trim();
    console.log(`${LOG_PREFIX} lookup started dynamicLinkId=${normalizedId || '(empty)'}`);
    if (!normalizedId) {
        return {
            ok: false,
            code: 'MISSING_ORDER_ID',
            message: 'אופס... לא מצאתי את ההזמנה שלך',
            debug: {
                reason: 'missing_dynamic_link_id',
                requestedDynamicLinkId: normalizedId,
            },
        };
    }

    try {
        const record = await getPublicDashboardOrder(normalizedId);
        console.log(`${LOG_PREFIX} query finished matches=${record ? 1 : 0}`);

        if (!record) {
            return {
                ok: false,
                code: 'ORDER_NOT_FOUND',
                message: 'אופס... לא מצאתי את ההזמנה שלך',
                debug: {
                    reason: 'record_not_found',
                    requestedDynamicLinkId: normalizedId,
                },
            };
        }

        const rawStatus = statusValueToString(record.status);
        const normalizedStatus = normalizePublicStatus(record.status);
        const isExpiredByStatus = EXPIRED_STATUSES.includes(normalizedStatus);
        if (isExpiredByStatus) {
            return {
                ok: false,
                code: 'ORDER_LINK_EXPIRED',
                message: EXPIRED_PUBLIC_ORDER_MESSAGE,
                debug: {
                    reason: 'status_marked_as_expired',
                    requestedDynamicLinkId: normalizedId,
                    recordId: record._id,
                    orderNumber: record.orderNumber || '',
                    rawStatus,
                    normalizedStatus,
                    expiredStatuses: EXPIRED_STATUSES,
                    isExpiredByStatus,
                    hasCheckoutLink: !!record.checkoutLink,
                    customerName: record.customerName || '',
                    createdDate: record._createdDate || null,
                },
            };
        }

        const couponDetails = safeParseJson(record.couponDetails, null);
        const statusConfig = getPublicStatusConfig(record.status);
        const products = normalizePublicProducts(record.products);
        const priceDisplay = computePublicPriceDisplay(record, couponDetails);
        const showHeroPrice = !isPaidOrderStatus(record.status);
        console.log(`${LOG_PREFIX} CMS record`, {
            id: record._id,
            checkoutId: record.checkoutId,
            customerName: record.customerName,
            customerPhone: record.customerPhone,
            totalPrice: record.totalPrice,
            status: record.status,
            hasCoupon: !!couponDetails,
            createdDate: record._createdDate || null,
            productsCount: products.length,
            products,
            priceDisplay,
            showHeroPrice,
        });

        return {
            ok: true,
            order: {
                customerName: record.customerName || '',
                createdDate: record._createdDate || null,
                customerPhone: record.customerPhone || '',
                totalPrice: Number(record.totalPrice || 0),
                originalPrice: priceDisplay.originalPrice,
                payPrice: priceDisplay.payPrice,
                showCouponPriceCompare: priceDisplay.showCompare,
                showHeroPrice,
                couponDetailsText: formatPublicCouponDetails(couponDetails),
                hasCoupon: !!couponDetails,
                status: normalizeOrderStatus(record.status) || 'sent',
                statusText: statusConfig.text,
                statusTone: statusConfig.tone,
                canContinue: statusConfig.canContinue,
                ctaLabel: statusConfig.ctaLabel,
                products,
            },
        };
    } catch (err) {
        console.error(`${LOG_PREFIX} getPublicOrderForIframe failed:`, err);
        return {
            ok: false,
            code: 'ORDER_LOOKUP_FAILED',
            message: 'אופס... לא מצאתי את ההזמנה שלך',
            debug: {
                reason: 'lookup_exception',
                requestedDynamicLinkId: normalizedId,
                errorMessage: err.message || String(err),
            },
        };
    }
}

/**
 * יוצר checkout חדש בלחיצת לקוח ומחזיר את ה-URL להפניה.
 * נקרא מ-ORDER_IFRAME_PAGE_CODE.js בלחיצה על כפתור התשלום.
 */
export async function createPublicCheckoutForOrder(dynamicLinkId) {
    const normalizedId = String(dynamicLinkId || '').trim();
    console.log(`${LOG_PREFIX} createPublicCheckoutForOrder started dynamicLinkId=${normalizedId}`);

    if (!normalizedId) {
        return { ok: false, code: 'MISSING_ORDER_ID', message: 'מזהה הזמנה חסר' };
    }

    try {
        const record = await getPublicDashboardOrder(normalizedId);

        if (!record) {
            return { ok: false, code: 'ORDER_NOT_FOUND', message: 'אופס... לא מצאתי את ההזמנה שלך' };
        }

        const normalizedStatus = normalizeOrderStatus(record.status);
        if (NON_PAYABLE_STATUSES.has(normalizedStatus)) {
            return { ok: false, code: 'ORDER_NOT_PAYABLE', message: 'לא ניתן לשלם עבור הזמנה זו' };
        }

        let sessionData = safeParseCheckoutSessionData(record.checkoutSessionData);
        let draft = sessionData?.draft;
        if (!draft) {
            // Backward-compatibility and resiliency: rebuild draft from order fields
            // when checkoutSessionData is missing/empty on old or partially migrated records.
            draft = buildDraftFallbackFromRecord(record);
            sessionData = {
                version: 1,
                draft,
                history: [],
                latest: null,
            };
            console.warn(`${LOG_PREFIX} checkoutSessionData missing; using fallback draft for record ${record._id}`);
        }

        console.log(`${LOG_PREFIX} Creating checkout from draft for record ${record._id}`);

        const checkoutResult = await createDashboardCheckout({
            products: draft.products,
            orderChangeNotes: draft.orderChangeNotes || '',
            couponCode: draft.couponCode || null,
            lockCouponCode: !!draft.lockCouponCode,
        });

        const updatedSession = appendCheckoutToHistory(
            sessionData,
            checkoutResult.checkoutId,
            checkoutResult.checkoutUrl,
            'public_click'
        );

        const currentRecord = await wixData.get('DashboardOrders', record._id, { suppressAuth: true });
        await wixData.update('DashboardOrders', {
            ...currentRecord,
            checkoutId: checkoutResult.checkoutId,
            checkoutLink: checkoutResult.checkoutUrl,
            checkoutSessionData: JSON.stringify(updatedSession),
        }, { suppressAuth: true });

        console.log(`${LOG_PREFIX} Checkout created on click: ${checkoutResult.checkoutId}`);

        return {
            ok: true,
            checkoutUrl: checkoutResult.checkoutUrl,
        };
    } catch (err) {
        console.error(`${LOG_PREFIX} createPublicCheckoutForOrder failed:`, err);
        return {
            ok: false,
            code: 'CHECKOUT_CREATION_FAILED',
            message: 'אירעה שגיאה ביצירת קישור התשלום. נסי שוב מאוחר יותר.',
        };
    }
}
